        <!-- Специфика для разных типов проектов -->
        <mxCell id="project_specifics" value="СПЕЦИФИКА ПО ТИПАМ ПРОЕКТОВ:&#xa;&#xa;КОММЕРЧЕСКИЙ/ИМИДЖЕВЫЙ:&#xa;• Обязательно окончание договора&#xa;• Подписание закрывающих документов&#xa;• Получение актов выполненных работ&#xa;• Обязательные визы ДКК&#xa;&#xa;ВНУТРЕННИЙ/ИНВЕСТИЦИОННЫЙ:&#xa;• Договор не заключался&#xa;• При формировании НМА - защита на ТК&#xa;• Возможно формирование НМА&#xa;• Визы ДКК - обязательно&#xa;&#xa;ОБЩИЕ ПРОЦЕССЫ:&#xa;• Утверждение документов на закрытие&#xa;• Архивирование в ИС УТЗ&#xa;• Выпуск приказа о закрытии&#xa;• Сдача документов в архив" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#666666;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="300" height="280" as="geometry" />
        </mxCell>
        
